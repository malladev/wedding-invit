# Base PostgreSQL (Neon, Supabase, Vercel Postgres...)
DATABASE_URL=postgresql://user:motdepasse@hote:5432/base?sslmode=require

# Clé secrète de chiffrement des QR codes (32 caractères minimum).
# Générez-la avec : openssl rand -base64 48
# Ne la changez plus après la création des premières cartes, sinon elles deviennent invalides.
QR_SECRET_KEY=

# Code d'accès des agents à la page /scan (choisissez un code long)
SCAN_PIN=

# Facultatif : nombre maximum d'invitations (0 = illimité)
MAX_INVITATIONS=0

# Facultatif : active l'aperçu /api/apercu en production
ALLOW_PREVIEW=0
